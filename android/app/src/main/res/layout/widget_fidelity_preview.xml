<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#0F9F76">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💳 Fidelity card"
        android:textColor="#FFFFFFFF"
        android:textStyle="bold"
        android:textSize="13sp"
        android:maxLines="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Il Gigante"
        android:textColor="#FFFFFFFF"
        android:textStyle="bold"
        android:textSize="19sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="3dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:padding="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="#FFFFFFFF">
        <TextView android:layout_width="4dp" android:layout_height="match_parent" android:background="#FF000000" android:layout_marginEnd="3dp" />
        <TextView android:layout_width="2dp" android:layout_height="match_parent" android:background="#FF000000" android:layout_marginEnd="5dp" />
        <TextView android:layout_width="7dp" android:layout_height="match_parent" android:background="#FF000000" android:layout_marginEnd="3dp" />
        <TextView android:layout_width="3dp" android:layout_height="match_parent" android:background="#FF000000" android:layout_marginEnd="6dp" />
        <TextView android:layout_width="6dp" android:layout_height="match_parent" android:background="#FF000000" android:layout_marginEnd="4dp" />
        <TextView android:layout_width="2dp" android:layout_height="match_parent" android:background="#FF000000" android:layout_marginEnd="5dp" />
        <TextView android:layout_width="8dp" android:layout_height="match_parent" android:background="#FF000000" android:layout_marginEnd="3dp" />
        <TextView android:layout_width="3dp" android:layout_height="match_parent" android:background="#FF000000" android:layout_marginEnd="6dp" />
        <TextView android:layout_width="5dp" android:layout_height="match_parent" android:background="#FF000000" android:layout_marginEnd="4dp" />
        <TextView android:layout_width="2dp" android:layout_height="match_parent" android:background="#FF000000" android:layout_marginEnd="5dp" />
        <TextView android:layout_width="7dp" android:layout_height="match_parent" android:background="#FF000000" android:layout_marginEnd="3dp" />
        <TextView android:layout_width="4dp" android:layout_height="match_parent" android:background="#FF000000" />
    </LinearLayout>
</LinearLayout>
