<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/share_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="3dp">
    <ImageView android:id="@+id/share_widget_root_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_bg_soft" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="4dp">
        <LinearLayout android:id="@+id/share_widget_header" android:layout_width="match_parent" android:layout_height="19dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/share_widget_logo" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/logo_fainance" android:scaleType="centerInside" />
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginLeft="2dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
                <TextView android:id="@+id/share_widget_title" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="bottom" android:singleLine="true" android:text="Share" android:textColor="#FFFFFF" android:textSize="7sp" android:textStyle="bold" />
                <TextView android:id="@+id/share_widget_project" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:ellipsize="end" android:gravity="top" android:singleLine="true" android:text="Progetto" android:textColor="#D8D6F2" android:textSize="6sp" />
            </LinearLayout>
        </LinearLayout>
        <FrameLayout android:id="@+id/share_widget_action" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="2dp" android:layout_weight="1">
            <ImageView android:id="@+id/share_widget_action_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="1dp"><TextView android:id="@+id/share_widget_action_icon" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="2" android:gravity="center|bottom" android:text="+" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" /><TextView android:id="@+id/share_widget_action_label" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center|top" android:singleLine="true" android:text="Spesa" android:textColor="#FFFFFF" android:textSize="8sp" android:textStyle="bold" /></LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
