<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voiceAssistantWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_voice_assistant_bg"
    android:clickable="true"
    android:contentDescription="@string/widget_voice_assistant_description"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="3dp">

    <ImageView
        android:layout_width="30dp"
        android:layout_height="34dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_voice_assistant_name"
        android:scaleType="fitCenter"
        android:src="@drawable/ai_grillo_mascot_transparent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_voice_assistant_name"
            android:textColor="#292642"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_voice_assistant_tap"
            android:textColor="#6A6682"
            android:textSize="8sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/widget_voice_assistant_mic_bg"
        android:contentDescription="@string/widget_voice_assistant_tap"
        android:padding="4dp"
        android:src="@drawable/ic_widget_voice_microphone" />
</LinearLayout>
