<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="5dp">
    <ImageView android:id="@+id/widget_root_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_bg_soft" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <FrameLayout android:id="@+id/widget_add_expense" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginBottom="4dp" android:layout_marginRight="4dp" android:layout_weight="1"><ImageView android:id="@+id/widget_add_expense_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" /><TextView android:id="@+id/widget_add_expense_icon" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="−" android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold" /></FrameLayout>
            <FrameLayout android:id="@+id/widget_add_income" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginBottom="4dp" android:layout_marginLeft="4dp" android:layout_weight="1"><ImageView android:id="@+id/widget_add_income_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" /><TextView android:id="@+id/widget_add_income_icon" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="+" android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold" /></FrameLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <FrameLayout android:id="@+id/widget_voice_action" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginRight="4dp" android:layout_marginTop="4dp" android:layout_weight="1"><ImageView android:id="@+id/widget_voice_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" /><TextView android:id="@+id/widget_voice_icon" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="🎙" android:textColor="#FFFFFF" android:textSize="29sp" /></FrameLayout>
            <FrameLayout android:id="@+id/widget_receipt_action" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginLeft="4dp" android:layout_marginTop="4dp" android:layout_weight="1"><ImageView android:id="@+id/widget_receipt_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" /><TextView android:id="@+id/widget_receipt_icon" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="📷" android:textColor="#FFFFFF" android:textSize="29sp" /></FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
